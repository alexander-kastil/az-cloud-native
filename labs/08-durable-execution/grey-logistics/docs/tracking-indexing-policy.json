{
  "indexingMode": "consistent",
  "automatic": true,
  "includedPaths": [
    {
      "path": "/*"
    }
  ],
  "excludedPaths": [
    {
      "path": "/_etag/?"
    }
  ],
  "compositeIndexes": [
    [
      {
        "path": "/scanType",
        "order": "ascending"
      },
      {
        "path": "/occurredAt",
        "order": "descending"
      }
    ]
  ]
}
