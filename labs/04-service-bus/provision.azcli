az account set --subscription "Visual Studio Enterprise Subscription"
SB_ID=$(az servicebus namespace list --resource-group rg-azn-labs --query "[0].id" --output tsv)
USER_OBJECT_ID=$(az ad signed-in-user show --query id --output tsv)
az role assignment create --role "Azure Service Bus Data Sender" --assignee-object-id $USER_OBJECT_ID --assignee-principal-type User --scope $SB_ID
